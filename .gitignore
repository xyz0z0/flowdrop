# build output
/dist/
/web/node_modules/
/tests/node_modules/
/tests/test-results/
/tests/playwright-report/
/server/internal/webui/dist/*
!/server/internal/webui/dist/.placeholder

# local data & config
/data/
/.data/
*.db
*.db-wal
*.db-shm
/config.json

# local secrets: env files and signing keys
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# editor / OS
.DS_Store
*.swp

# typescript incremental build info
/web/*.tsbuildinfo
/tests/test-results/.last-run.json

# generated Vite config output
/web/vite.config.js

# python caches
__pycache__/
*.pyc
